# Jarvis local configuration
# Copy to .env only when overriding defaults. The server loads .env automatically.

# Server and network
# DASHBOARD_PORT=4820
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_TOKEN=replace-with-a-long-random-secret
# DASHBOARD_ALLOWED_HOSTS=jarvis-host.example-tailnet.ts.net

# Local operational state. Keep SQLite outside the repo and outside synced storage.
# DASHBOARD_DATA_DIR=C:/Users/your-name/AppData/Local/Jarvis/development
# DASHBOARD_DB_PATH=C:/Users/your-name/AppData/Local/Jarvis/development/dashboard.db

# Agent runtime homes
# CLAUDE_HOME=C:/Users/your-name/.claude

# Portable Markdown state
# JARVIS_NOTES_DIR=C:/Users/your-name/JarvisNotes
# JARVIS_BUSINESS_DIR=C:/Users/your-name/JarvisBusiness
# JARVIS_SKILLS_DIR=C:/Users/your-name/JarvisSkills
# JARVIS_NEGLECT_DAYS=7

# Background recovery and synchronization
# DASHBOARD_STALE_MINUTES=180
# DASHBOARD_WORKING_IDLE_SECONDS=120
# DASHBOARD_SESSION_SYNC_MS=30000

# Agentic OS feature flags. They are enabled by default.
# Set a value to 0, false, off, or no to disable that surface.
# JARVIS_FEATURE_CODEX_KERNEL=1
# JARVIS_FEATURE_UNIFIED_MISSIONS=1
# JARVIS_FEATURE_MOBILE_CODEX_REMOTE=1
# JARVIS_FEATURE_CODEX_SCHEDULES=1

# Provider kill switches. Default routing is signed-in Codex plus Claude Code.
# JARVIS_PROVIDER_CODEX_DISABLED=1
# JARVIS_PROVIDER_CLAUDE_CODE_DISABLED=1

# Local Git-ignored configuration paths
# PROVIDERS_CONFIG_PATH=C:/absolute/path/providers.json
# BUSINESS_CONFIG_PATH=C:/absolute/path/business.json
# GITHUB_CONFIG_PATH=C:/absolute/path/github.json

# GitHub integration normally uses the signed-in gh CLI.
# GITHUB_REPOS=owner/repo,org/another-repo
# GITHUB_PAT=                       # optional REST fallback; keep secret

# Proactive Jarvis defaults
# JARVIS_PERSONA=0                 # neutral phrasing instead of the Jarvis voice

# Dormant compatibility surfaces
# Legacy API-key and local-model adapters are disabled in the example provider
# config and excluded from default mission/brain routing. Do not add API keys as
# an automatic fallback for an expired Codex or Claude subscription session.
# LEGACY_SURFACES=1                # temporarily restores retired browse/computer-use pages
