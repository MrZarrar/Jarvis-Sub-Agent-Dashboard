              />
            </button>
          </label>
        </div>
      </div>
    </section>
    <section
      class="scroll-mt-24"
      id="assistant-access"
    >
      <h3
        class="text-sm font-medium text-gray-300 flex items-center gap-2 mb-1"
      >
        <svg
          class="lucide lucide-shield-alert w-4 h-4 text-gray-500"
          fill="none"
          height="24"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"
          />
          <path
            d="M12 8v4"
          />
          <path
            d="M12 16h.01"
          />
        </svg>
        Assistant Access
      </h3>
      <p
        class="text-xs text-gray-500 mb-4"
      >
        Directories the assistant (Mini JARVIS, chat, Siri) may read, write, or run shell commands in. Empty by default - no filesystem or shell access until you add a root here. Actions still require confirmation per their risk level.
      </p>
      <div
        class="card p-5 space-y-4"
      >
        <div>
          <p
            class="text-xs font-medium text-gray-300 mb-1"
          >
            Full agent (Claude)
          </p>
          <p
            class="text-xs text-gray-500 mb-2"
          >
            Let Mini JARVIS delegate to Claude for live internet access, the agent-reach skill (Twitter/Reddit/YouTube/GitHub/etc.), and file/shell work. 'Full access' runs it with no confirmation.
          </p>
          <div
            class="flex gap-1.5"
          >
            <button
              class="px-3 py-1.5 text-xs rounded-lg border transition-colors disabled:opacity-50 bg-violet-500/20 border-violet-500/50 text-violet-200"
            >
              Off
            </button>
            <button
              class="px-3 py-1.5 text-xs rounded-lg border transition-colors disabled:opacity-50 bg-surface-4 border-surface-3 text-gray-400 hover:text-gray-200"
            >
              Ask first
            </button>
            <button
              class="px-3 py-1.5 text-xs rounded-lg border transition-colors disabled:opacity-50 bg-surface-4 border-surface-3 text-gray-400 hover:text-gray-200"
            >
              Full access
            </button>
          </div>
        </div>
        <div
          class="border-t border-surface-3"
        />
        <div
          class="flex items-start justify-between gap-3"
        >
          <div>
            <p
              class="text-xs font-medium text-gray-300 mb-1"
            >
              Browse without asking
            </p>
            <p
              class="text-xs text-gray-500"
            >
              Let Mini JARVIS open a browser and search/navigate (streamed to the Browse view) with no confirmation. When off, a browse needs one tap first. Read-only navigation only.
            </p>
          </div>
          <button
            aria-checked="false"
            class="shrink-0 px-3 py-1.5 text-xs rounded-lg border transition-colors disabled:opacity-50 bg-surface-4 border-surface-3 text-gray-400 hover:text-gray-200"
            role="switch"
          >
            Ask first
          </button>
        </div>
        <div
          class="border-t border-surface-3"
        />
        <div
          class="flex items-start justify-between gap-3"
        >
          <div>
            <p
              class="text-xs font-medium text-gray-300 mb-1"
            >
              Control my screen without asking
            </p>
            <p
              class="text-xs text-gray-500"
            >
              Let Mini JARVIS click and type on your REAL Mac desktop (streamed to the Computer Use view) with no confirmation. When off, it needs one tap first. This controls your actual mouse and keyboard - stronger than Browse.
            </p>
          </div>
          <button
            aria-checked="false"
            class="shrink-0 px-3 py-1.5 text-xs rounded-lg border transition-colors disabled:opacity-50 bg-surface-4 border-surface-3 text-gray-400 hover:text-gray-200"
            role="switch"
          >
            Ask first
          </button>
        </div>
        <div
          class="border-t border-surface-3"
        />
        <div
          class="flex items-center gap-3"
        >
          <input
            class="flex-1 bg-surface-4 border border-surface-3 rounded-lg px-3 py-2 text-sm text-gray-200 font-mono focus:outline-none focus:border-violet-500/50"
            placeholder="/absolute/path/to/a/project"
            type="text"
            value=""
          />
          <button
            class="btn-primary px-4 py-2 text-sm disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-1.5"
            disabled=""
          >
            <svg
              class="lucide lucide-plus w-3.5 h-3.5"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M5 12h14"
              />
              <path
                d="M12 5v14"
              />
            </svg>
            Add
          </button>
        </div>
        <p
          class="text-xs text-gray-600 italic"
        >
          No roots granted - file and shell actions are blocked.
        </p>
      </div>
    </section>
    <section
      class="scroll-mt-24"
      id="vault"
