    <section
      class="scroll-mt-24"
      id="hud"
    >
      <h3
        class="text-sm font-medium text-gray-300 flex items-center gap-2 mb-1"
      >
        <svg
          class="lucide lucide-cpu w-4 h-4 text-gray-500"
          fill="none"
          height="24"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="24"
          xmlns="http://www.w3.org/2000/svg"
