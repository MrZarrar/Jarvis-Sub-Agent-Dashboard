                d="m9 9 6 6"
              />
            </svg>
            CLI only
          </div>
          <ul
            class="text-[11.5px] text-gray-300 leading-[1.55] space-y-1 marker:text-rose-500/40 list-disc pl-4"
          >
            <li>
              Built-in slash commands (
              <code
                class="text-[10.5px] text-gray-200"
              >
                /help
              </code>
              ,
               
              <code
                class="text-[10.5px] text-gray-200"
              >
                /model
              </code>
              ,
               
              <code
                class="text-[10.5px] text-gray-200"
              >
                /clear
              </code>
              ,
               
              <code
                class="text-[10.5px] text-gray-200"
              >
                /compact
              </code>
              ) - they mutate CLI-only state
            </li>
            <li>
